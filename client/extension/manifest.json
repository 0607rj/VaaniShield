{
  "manifest_version": 3,
  "name": "VaaniShield – AI Voice Deepfake Detector",
  "short_name": "VaaniShield",
  "version": "1.0.0",
  "description": "Check whether a voice on any website (WhatsApp Web, Instagram, YouTube, X, Facebook…) is real or AI-generated.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VaaniShield – check a voice",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabCapture", "offscreen", "contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
