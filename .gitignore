# ---- VaaniShield .gitignore (docs/reproducibility.md §1) ----
# Data, audio, weights and secrets NEVER enter Git.

# Data: audio and downloaded third-party files never tracked. Tracked: data/manifests/** (our CSVs, licence
# registry, provenance JSON, open licence texts).
data/raw/
data/processed/
data/private/
**/private/
**/consent/

# Audio
*.wav
*.flac
*.mp3
*.ogg
*.opus
*.m4a
*.aac
*.amr
*.webm
*.sph

# Model weights / serialized objects / bundles
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.joblib
*.pkl
checkpoints/
bundles/
ml/experiments/*/checkpoints/
hf_cache/
.cache/

# Archives (dataset downloads)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Source PDFs at repo root (papers / internal documents; Q7 undecided)
/*.pdf

# Secrets
.env
.env.*
!.env.example
kaggle.json
credentials.json
*.pem
*.key

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Machine-specific environment reports (summaries are copied into PROJECT_STATE.md)
environment/reports/*.json

# Node (client/, if used)
node_modules/
client/dist/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Training outputs (checkpoints, scores)
runs/

# generated by the GPU install route (docs/GPU_HANDOFF.md)
constraints.txt
